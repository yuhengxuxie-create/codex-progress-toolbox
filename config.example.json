{
  "thread_ids": "${PROGRESS_THREAD_IDS}",
  "notification": {
    "provider": "${PROGRESS_NOTIFY_PROVIDER:-generic}",
    "webhook_url": "${PROGRESS_WEBHOOK_URL}",
    "auth_type": "${PROGRESS_WEBHOOK_AUTH_TYPE:-none}",
    "bearer_token": "${PROGRESS_WEBHOOK_BEARER_TOKEN}",
    "target_umo": "${PROGRESS_ASTRBOT_TARGET_UMO}",
    "hmac_secret": "${PROGRESS_WEBHOOK_HMAC_SECRET}",
    "feishu_signing_secret": "${PROGRESS_FEISHU_SECRET}",
    "headers_json": "${PROGRESS_WEBHOOK_HEADERS_JSON:-{}}",
    "allow_http_localhost": "${PROGRESS_ALLOW_HTTP_LOCALHOST:-false}",
    "timeout_seconds": "${PROGRESS_WEBHOOK_TIMEOUT_SECONDS:-10}",
    "max_attempts": "${PROGRESS_WEBHOOK_MAX_ATTEMPTS:-3}"
  },
  "classifier": {
    "mode": "${PROGRESS_CLASSIFIER_MODE:-auto}",
    "api_key": "${OPENAI_API_KEY}",
    "base_url": "${OPENAI_BASE_URL:-https://api.openai.com/v1}",
    "model": "${PROGRESS_CLASSIFIER_MODEL:-gpt-5-mini}",
    "timeout_seconds": "${PROGRESS_CLASSIFIER_TIMEOUT_SECONDS:-30}"
  },
  "codex": {
    "command": "${PROGRESS_CODEX_COMMAND:-codex}",
    "title_overrides_json": "${PROGRESS_THREAD_TITLES_JSON:-{}}",
    "request_timeout_seconds": "${PROGRESS_CODEX_TIMEOUT_SECONDS:-10}"
  },
  "log_file": "${PROGRESS_LOG_FILE:-.state/progress-notify.log}"
}
