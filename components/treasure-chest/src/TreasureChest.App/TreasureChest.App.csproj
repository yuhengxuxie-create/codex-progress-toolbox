<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>..\..\resources\app.ico</ApplicationIcon>
    <AssemblyName>TreasureChest</AssemblyName>
    <RootNamespace>TreasureChest</RootNamespace>
    <Version>1.5.0</Version>
    <AssemblyVersion>1.5.0.0</AssemblyVersion>
    <FileVersion>1.5.0.0</FileVersion>
    <InformationalVersion>1.5.0</InformationalVersion>
    <Product>Codex Feishu Ecosystem - TreasureChest</Product>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\TreasureChest.Core\TreasureChest.Core.csproj" />
    <EmbeddedResource Include="..\..\resources\app.ico" LogicalName="TreasureChest.AppIcon" />
    <EmbeddedResource Include="..\..\resources\app.png" LogicalName="TreasureChest.AppIconPng" />
  </ItemGroup>
</Project>
